# Supabase owns PostgreSQL, authentication, storage, realtime and RPCs.
# Never place SUPABASE_SERVICE_ROLE_KEY or sb_secret_* in Flutter Web.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Firebase is Hosting-only. No Firebase Auth, Firestore, Realtime Database,
# Storage SDK, or Firebase runtime configuration is used by this Flutter app.
FIREBASE_PROJECT_ID=kaj-erp
FIREBASE_HOSTING_PROJECT_ID=kaj-erp
