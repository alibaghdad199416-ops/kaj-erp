+  Future<void> _loadDetails() async {
+    try {
+      final snapshot = await _repository.getOrderSnapshot(_order.id);
+      if (!mounted) return;
+      setState(() {
+        _order = snapshot.order;
+        _lines = snapshot.lines;
+        _costs = snapshot.reconciliation;
+        _loading = false;
+        _error = null;
+        _loadWarning = null;
+      });
+      return;
+    } catch (snapshotError) {
