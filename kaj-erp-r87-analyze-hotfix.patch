+            warehouseId: item.isService ? null : line.warehouseId,
+            quantity: int.tryParse(line.quantity.text.trim()) ?? 0,
+            unitPrice: double.tryParse(line.unitPrice.text.trim()) ?? 0,
+          ),
+        );
+      }
+      final controller = context.read<MaintenanceController>();
+      if (_editing) {
